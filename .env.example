# Google AI Studio -> aistudio.google.com/apikey
GEMINI_API_KEY=

# Ordered fallback chain. Use "-latest" aliases only: pinned model names
# get retired without warning (gemini-2.5-flash already 404s).
GEMINI_MODEL_CHAIN=gemini-flash-latest,gemini-flash-lite-latest,gemini-3.5-flash

# Required in production - sessions are signed with this.
SECRET_KEY=

# Defaults to local SQLite. Note: ephemeral on free hosting tiers.
DATABASE_URL=sqlite:///./receipt_extract.db

# Legal identity shown on Terms/Refund/Privacy pages. Paddle's domain
# review requires the sole proprietor's brand in the Terms and working
# buyer support contact details - these must be real before submitting.
LEGAL_NAME=
SUPPORT_EMAIL=
BRAND_NAME=Ledgerlift
JURISDICTION=India

# Set true ONLY once billing is actually enabled on the Gemini API key.
# On the unpaid tier Google uses submitted content to improve its
# products and human reviewers may read it; the privacy policy discloses
# whichever tier is set here, so a wrong value makes the policy untrue.
GEMINI_PAID_TIER=false
