# Google AI Studio -> aistudio.google.com/apikey
GEMINI_API_KEY=

# Ordered fallback chain. Use "-latest" aliases only: pinned model names
# get retired without warning (gemini-2.5-flash already 404s).
GEMINI_MODEL_CHAIN=gemini-flash-latest,gemini-flash-lite-latest,gemini-3.5-flash

# Required in production - sessions are signed with this.
SECRET_KEY=

# Defaults to local SQLite. Note: ephemeral on free hosting tiers.
DATABASE_URL=sqlite:///./receipt_extract.db
